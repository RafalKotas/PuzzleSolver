{
  "compilerOptions": {
    "target": "es2020",
    "lib": ["dom", "dom.iterable", "esnext"],
    "skipLibCheck": true,
    "esModuleInterop": true,
    "allowSyntheticDefaultImports": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "module": "esnext",
    "moduleResolution": "node",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "jsx": "react-jsx",
    "baseUrl": "src",
    "paths": {
      "@/*": ["*"],
      "@store/*": ["store/*"],
      "@layout/*": ["store/layout/*"],
      "@functions/*": ["functions/*"],
      "@components/*": ["CommonComponents/*"],
      // "@storelayout/*": ["./src/store/layout/*"],
      // "@storedata/*": ["./src/store/data/*"],
      // "@storefilters/*": ["./src/store/filters/*"],
      // "@storepuzzleLogic/*": ["./src/store/puzzleLogic/*"],
      // "@storedisplay/*": ["./src/store/display/*"],
      // "@storecommons/*": ["./src/store/commons/*"],
    }
  },
  "include": ["src"]
}